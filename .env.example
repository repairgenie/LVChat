# LVChat deployment configuration (SaaS module + secrets).
# Copy to `.env` and fill in. NEVER commit `.env`. Nothing here overrides
# variables already set in the environment (e.g. CHAT_DB, CHAT_MODULES).

# ── SaaS module ──────────────────────────────────────────────────────────────
# Master switch for plan metering (can also be toggled in Admin → SaaS).
# Off = the install behaves exactly as before: no limits enforced.
SAAS_ENABLED=0

# Hard ceiling on total concurrent WebSocket connections (never exceeded,
# even by "unlimited" plans).
SAAS_MAX_CONNECTIONS_GLOBAL=200

# Days a user stays on a paid plan after a failed/expired payment before the
# plan auto-downgrades to Free.
SAAS_GRACE_DAYS=3

# Checkout currency for all providers (ISO 4217 code, e.g. usd, eur, gbp).
SAAS_CHECKOUT_CURRENCY=usd

# ── Platform fee (developer support fee) ─────────────────────────────────────
# Every paid transaction routes a small fee to the software developer so
# support scales with the userbase. Configured HERE in the deployment env —
# admins CANNOT turn it off. Each fee is also logged in saas_payments
# (kind = platform_fee).
SAAS_PLATFORM_FEE=0.75
SAAS_PLATFORM_FEE_CURRENCY=usd

# Where the fee is paid out. For Stripe, set a Stripe Connect account id
# (acct_...) and the module creates a Transfer of the fee per settled payment.
# Leave blank to record the fee in the ledger without moving money.
SAAS_PLATFORM_FEE_DESTINATION=

# Developer mode: exposes a toggle in Admin → SaaS → Billing that lets the
# platform fee be switched off locally for testing. Leave 0 in production.
SAAS_DEVELOPER_MODE=0

# ── Realtime gateway (existing core) ─────────────────────────────────────────
# WS_PORT=8080
# WS_PUSH_URL=http://127.0.0.1:9001/push
