# LVChat Messenger Web — client configuration
#
# This client is a *standalone app* that logs into ONE LVChat server. Instead
# of a multi-profile launcher, the site it connects to is set here by the admin.
#
# Copy this file to .env, set LVCHAT_SERVER_URL, then run `npm run build`.
# (Changes require a rebuild — the values are baked into the static dist/.)

# The LVChat server this messenger connects to (required, http:// or https://).
LVCHAT_SERVER_URL=https://chat.example.com

# Branding shown in the login card, the window title, and the PWA manifest.
# APP_NAME=LVChat Messenger
# APP_SHORT_NAME=LVChat

# PWA colours (hex). APP_THEME_COLOR is also used for the install header.
# APP_THEME_COLOR=#26283c
# APP_BACKGROUND_COLOR=#1a1a24
