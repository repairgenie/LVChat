{
  "id": "webrtc",
  "name": "WebRTC Voice (LiveKit)",
  "version": "1.1.0",
  "description": "Calls, channel voice, video, group calls, waiting rooms, moderation and recording via a self-hosted LiveKit SFU.",
  "author": "LVChat",
  "requires": {
    "lvchat": ">=0.9.0beta",
    "php": ">=8.1"
  },
  "order": 10,
  "admin": [
    { "id": "voice", "label": "Voice (LiveKit)", "url": "/admin/voice", "roles": ["admin"] }
  ],
  "settings": {
    "voice_enabled": "0",
    "livekit_url": "ws://127.0.0.1:7880",
    "livekit_api_key": "",
    "livekit_api_secret": "",
    "voice_max_users": "50",
    "voice_talker_cap": "8",
    "voice_bitrate": "40000",
    "voice_quality_preset": "moderate",
    "call_ring_seconds": "20",
    "video_quality_default": "720p",
    "video_quality_available": "360p,480p,720p,1080p",
    "recording_enabled": "0",
    "recording_path": ""
  },
  "assets": {
    "css": ["css/voice.css"],
    "js": ["vendor/livekit-client.umd.js", "js/voice.js"]
  },
  "license": false
}
