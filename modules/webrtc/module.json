{
  "id": "webrtc",
  "name": "WebRTC Voice (LiveKit)",
  "version": "1.0.0",
  "description": "One-on-one audio calls and per-channel voice via a self-hosted LiveKit SFU.",
  "author": "LVChat",
  "license": "AGPL-3.0-only",
  "requires": {
    "lvchat": ">=1.7.1",
    "php": ">=8.1"
  },
  "order": 10,
  "admin": [
    { "id": "voice", "label": "Voice (LiveKit)", "url": "/admin/voice", "roles": ["admin"] }
  ],
  "settings": {
    "voice_enabled": "0",
    "livekit_url": "ws://127.0.0.1:7880",
    "livekit_api_key": "",
    "livekit_api_secret": "",
    "voice_max_users": "50",
    "voice_talker_cap": "8",
    "voice_bitrate": "40000",
    "voice_quality_preset": "moderate"
  },
  "assets": {
    "css": ["css/voice.css"],
    "js": ["vendor/livekit-client.umd.js", "js/voice.js"]
  },
  "license": false
}
