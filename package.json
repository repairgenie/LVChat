{
  "name": "lvchat",
  "version": "0.9.0beta",
  "description": "LVChat — Discord-style web chat (PHP + SQLite)",
  "private": true,
  "scripts": {
    "build": "tailwindcss -i ./src/assets/input.css -o ./public/assets/css/app.css --minify && npm run build:editor",
    "build:editor": "esbuild src/assets/tiptap-entry.js --bundle --minify --format=iife --outfile=public/assets/vendor/tiptap/tiptap-bundle.js",
    "watch": "tailwindcss -i ./src/assets/input.css -o ./public/assets/css/app.css --watch"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tiptap/core": "^3.31.0",
    "@tiptap/extension-color": "^3.31.0",
    "@tiptap/extension-highlight": "^3.31.0",
    "@tiptap/extension-image": "^3.31.0",
    "@tiptap/extension-link": "^3.31.0",
    "@tiptap/extension-placeholder": "^3.31.0",
    "@tiptap/extension-subscript": "^3.31.0",
    "@tiptap/extension-superscript": "^3.31.0",
    "@tiptap/extension-table": "^3.31.0",
    "@tiptap/extension-table-cell": "^3.31.0",
    "@tiptap/extension-table-header": "^3.31.0",
    "@tiptap/extension-table-row": "^3.31.0",
    "@tiptap/extension-task-item": "^3.31.0",
    "@tiptap/extension-task-list": "^3.31.0",
    "@tiptap/extension-text-align": "^3.31.0",
    "@tiptap/extension-underline": "^3.31.0",
    "@tiptap/pm": "^2.11.5",
    "@tiptap/starter-kit": "^3.31.0",
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.0"
  }
}
